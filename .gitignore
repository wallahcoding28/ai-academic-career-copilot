# ==========================================================
# AI Academic & Career Copilot - .gitignore
# ==========================================================

# 1. Python Virtual Environments, Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.venv/
.venv
venv/
env/
ENV/

# 2. Node & Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.cache/

# 3. SQLite Databases, Backups, WAL, SHM & Rollback Journals
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
database/*.db
database/*.backup*
database/*.bak
database/*.sqlite
database/*.sqlite3

# 4. Environment Variables & Credentials (explicitly allow .env.example)
.env*
!.env.example
*.env
backend/.env*
frontend/.env*

# 5. Application Logs, Temporary & Scratch Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
backend/logs/
scratch/
*.tmp
*.temp

# 6. IDEs & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 7. Internal / Non-Public Development Artifacts
PRIVATE_TEST_CHECKLIST.md
